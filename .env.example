APP_NAME="Transfer Pulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=my
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Cloud PostgreSQL (reporting source; keep the default DB local for auth)
REPORT_DB_URL=
REPORT_DB_HOST=127.0.0.1
REPORT_DB_PORT=5432
REPORT_DB_DATABASE=postgres
REPORT_DB_USERNAME=postgres
REPORT_DB_PASSWORD=
REPORT_DB_SCHEMA=public
REPORT_DB_SSLMODE=require
TRANSFER_REQUESTS_TABLE=transfer_requests

# First dashboard user (created by: php artisan db:seed)
ADMIN_NAME=Administrator
ADMIN_EMP_CODE=EMP-0001
ADMIN_PASSWORD=change-me-now

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Transaction image extraction API
TRANSACTION_IMAGE_API_URL=
TRANSACTION_IMAGE_API_KEY=
TRANSACTION_IMAGE_API_FIELD=image
MANUAL_RESPONSE_API_URL=
MANUAL_RESPONSE_API_KEY=
MANUAL_RESPONSE_API_FIELD=image
MANUAL_FAILED_RESPONSE_API_URL=
MANUAL_FAILED_RESPONSE_API_KEY=
